{
  "manifest_version": 3,
  "name": "智慧树课程助手",
  "version": "1.5.5",
  "description": "课程连播、章节测试与随堂练习辅助、本地题库及可选 API。",
  "permissions": ["storage", "debugger"],
  "optional_host_permissions": ["https://*/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "minimum_chrome_version": "118",
  "content_scripts": [{
    "matches": ["https://wisdom-mooc.zhihuishu.com/study/*"],
    "js": ["core.js", "content.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://onlineexamh5new.zhihuishu.com/stuExamWeb.html*"],
    "js": ["core.js", "chapter-engine.js", "chapter-dom.js", "chapter.js"],
    "run_at": "document_idle"
  }]
}
